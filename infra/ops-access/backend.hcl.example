# Copy this non-secret file outside the release bundle and replace the bucket
# and kms_key_id using the verified bootstrap-state backend output.
# Keep credentials out of this file. The release wrapper can add a verified
# backend profile separately from the AWS provider profile at runtime.
# The key is deliberately distinct from the baseline and from every workload.
bucket         = "node-operator-tfstate-123456789012-apnortheast2"
key            = "node-operator/ops-access/terraform.tfstate"
region         = "ap-northeast-2"
dynamodb_table = "node-operator-terraform-lock"
encrypt        = true
kms_key_id     = "arn:aws:kms:ap-northeast-2:123456789012:key/REPLACE_WITH_BOOTSTRAP_STATE_KEY_ID"
