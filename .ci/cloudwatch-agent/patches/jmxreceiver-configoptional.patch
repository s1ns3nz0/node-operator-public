+// insertDefault initializes an absent configoptional.Optional from an empty
+// configuration map so its value can be configured programmatically.
+func insertDefault[T any](opt *configoptional.Optional[T]) error {
+	if opt.HasValue() {
+		return nil
+	}
+
+	empty := confmap.NewFromStringMap(map[string]any{})
+	return empty.Unmarshal(opt)
+}
