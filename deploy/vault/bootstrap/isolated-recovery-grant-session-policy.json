{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectAndRevokeOnlyReviewedSealKeyGrants",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey", "kms:ListGrants", "kms:RevokeGrant"],
      "Resource": "arn:aws:kms:ap-northeast-2:123456789012:key/3bc15229-161c-4172-8a61-8ba0149f4890"
    },
    {
      "Sid": "CreateOnlyReviewedRecoveryHostGrant",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:kms:ap-northeast-2:123456789012:key/3bc15229-161c-4172-8a61-8ba0149f4890",
      "Condition": {
        "DateLessThan": {"aws:CurrentTime": "2026-09-10T12:00:00Z"},
        "StringEquals": {
          "kms:GranteePrincipal": "arn:aws:iam::123456789012:role/node-operator-baseline-vault-recovery"
        },
        "ForAllValues:StringEquals": {
          "kms:GrantOperations": ["Encrypt", "Decrypt", "DescribeKey"]
        },
        "Null": {"kms:GrantOperations": "false"}
      }
    }
  ]
}
