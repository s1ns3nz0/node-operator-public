{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteReleaseSignerInputOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_RELEASE_ARTIFACT_BUCKET/release-input/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "ReadSignerOutputOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_RELEASE_ARTIFACT_BUCKET/release-signer-output/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "ListSignerOutputOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_RELEASE_ARTIFACT_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "release-signer-output/*"
          ]
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "RunApprovedSignerOnly",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds"
      ],
      "Resource": "arn:aws:codebuild:ap-northeast-2:REPLACE_WITH_ACCOUNT_ID:project/node-operator-baseline-release-signer"
    }
  ]
}
