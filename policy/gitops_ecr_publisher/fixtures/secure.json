{
  "publisher": {
    "repository": "s1ns3nz0/node-operator-gitops",
    "environment": "gitops-client-ecr-publish",
    "audience": "sts.amazonaws.com"
  },
  "repository": {
    "image_tag_mutability": "IMMUTABLE",
    "scan_on_push": true,
    "prevent_destroy": true
  },
  "permissions": [
    {"name": "ecr:GetAuthorizationToken", "resource": "*"},
    {"name": "ecr:BatchCheckLayerAvailability", "resource": "arn:aws:ecr:ap-northeast-2:123456789012:repository/node-operator-baseline-gitops-client/node-operator-client"},
    {"name": "ecr:BatchGetImage", "resource": "arn:aws:ecr:ap-northeast-2:123456789012:repository/node-operator-baseline-gitops-client/node-operator-client"},
    {"name": "ecr:CompleteLayerUpload", "resource": "arn:aws:ecr:ap-northeast-2:123456789012:repository/node-operator-baseline-gitops-client/node-operator-client"},
    {"name": "ecr:DescribeImages", "resource": "arn:aws:ecr:ap-northeast-2:123456789012:repository/node-operator-baseline-gitops-client/node-operator-client"},
    {"name": "ecr:InitiateLayerUpload", "resource": "arn:aws:ecr:ap-northeast-2:123456789012:repository/node-operator-baseline-gitops-client/node-operator-client"},
    {"name": "ecr:PutImage", "resource": "arn:aws:ecr:ap-northeast-2:123456789012:repository/node-operator-baseline-gitops-client/node-operator-client"},
    {"name": "ecr:UploadLayerPart", "resource": "arn:aws:ecr:ap-northeast-2:123456789012:repository/node-operator-baseline-gitops-client/node-operator-client"}
  ]
}
