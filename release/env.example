# Non-secret defaults/overrides for interactive-hoodi-release.sh.
# Copy to .env at the checkout root OR to release/env under that same root,
# not both. An extracted release also accepts env at its bundle root.
# This example contains no operator identity or custody material. Keep actual
# values only in the local config; never upload that file with a release.
# Private keys, keystore passwords and Vault recovery shares are NEVER env inputs.
# Blank image overrides select the verified release's approved destinations.
# Missing release authority blocks deployment; manual input cannot replace it.
REGION=ap-northeast-2
# Blank selects Tokyo, or Seoul when the primary Region is Tokyo.
# The installer displays both Regions before resource creation.
AUDIT_REPLICA_REGION=
# Leave blank for node-<UTC YYMMDDHHMM>-<4 hex digits> on a fresh run:
# e.g. node-2609151420-a4f1 (20 characters including all prefixes/separators).
DEPLOYMENT_NAME=
VALIDATOR_SET=hoodi-example
# Your validator's 0x-prefixed 96-hex public key, not the publisher signing key.
# Leave blank for a new key ceremony. If set, the generated key must match it.
VALIDATOR_PUBLIC_KEY=
# Required user-owned withdrawal address; there is no maintainer-wallet fallback.
WITHDRAWAL_ADDRESS=
# Optional existing validator keystore directory. It must be an absolute path
# outside this repository and contain exactly one keystore-*.json plus one
# deposit_data-*.json. Leave blank to run a new key ceremony.
# Example path shape: /absolute/path/to/your/private-custody/validator_keys
EXISTING_KEYSTORE_DIR=
# Public HTTPS Beacon API used only to verify an already registered existing key.
HOODI_PUBLIC_BEACON_URL=https://ethereum-hoodi-beacon-api.publicnode.com
# Destination publisher trust, independent from pinned release-signature sources.
# For a self-hosted deployment, set all three fields in each group to the
# operator repository and separate GitOps repository they control. Obtain the
# numeric IDs from GitHub; no repository owned by this project is implied.
GITHUB_REPOSITORY=
GITHUB_OWNER_ID=
GITHUB_REPOSITORY_ID=
GITOPS_CLIENT_GITHUB_REPOSITORY=
GITOPS_CLIENT_GITHUB_OWNER_ID=
GITOPS_CLIENT_GITHUB_REPOSITORY_ID=
# Optional exact approved source or selected private ECR destination overrides.
# A different reference or digest is rejected before IAM or custody changes.
WEB3SIGNER_IMAGE=
POSTGRES_IMAGE=
PRYSM_IMAGE=
FENCE_IMAGE=
# Leave bootstrap image and client-chart values blank to use release approval
# bindings. Explicit values must match those bindings; absent mirrors are
# handled by the guarded pre-EKS artifact phase, not by selecting new digests.
ARGOCD_BOOTSTRAP_IMAGE=
VAULT_BOOTSTRAP_IMAGE=
CLIENT_CHART_VERSION=
CLIENT_CHART_DIGEST=
# Legacy setting retained for env compatibility; release authority determines
# the immutable chart source, so this value does not authorize another source.
CLIENT_CHART_SOURCE_REGION=ap-northeast-2
VAULT_CHART_VERSION=0.31.0
VAULT_CHART_DIGEST=sha256:85cfa6b40396a198a104fbf06c7cccaf75428db7201394f9061c272441bcd0e4
# Set WORK_DIR only for an existing, release-bound private run directory.
# Resume uses its recorded deployment and phase, never a newly generated name.
# Ceremony/activation outcomes must be proven before their next phase continues.
# WORK_DIR=/absolute/path/to/existing/run
